{
	admin off
}

:8080 {
	@foreignHost not host localhost 127.0.0.1
	@foreignOrigin {
		header Origin *
		not header Origin "http://{http.request.hostport}"
	}
	@crossSiteWrite {
		method POST DELETE
		header_regexp Sec-Fetch-Site ^(cross-site|same-site)$
	}
	@score path /score
	@console path /health /ready /auth/* /admin/* /reviews /reviews/* /model /stats /stats/* /blocklist /blocklist/* /rulesets /rulesets/* /simulations /simulations/*

	route {
		# Restrict the local console before adding credentials upstream.
		respond @foreignHost 403
		respond @foreignOrigin 403
		respond @crossSiteWrite 403

		# POST /score accepts only the service key, so the proxy adds it for the Tester page
		# after the backend confirms the caller's console session.
		forward_auth @score backend:{$BACKEND_PORT} {
			uri /auth/me
		}
		reverse_proxy @score backend:{$BACKEND_PORT} {
			header_up X-API-Key {env.API_KEY}
			header_down -X-API-Key
		}
		# Every other console request carries the session token of the signed-in account.
		reverse_proxy @console backend:{$BACKEND_PORT}
		root * /srv
		file_server
	}
}
