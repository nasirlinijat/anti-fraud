# Port the backend listens on
PORT=8080

# Host port for the Docker Compose console
FRONTEND_PORT=3000

# Key that clients send in the X-API-Key header to call POST /score.
# Use a long random value outside local development.
API_KEY=local-dev-key

# Optional JSON array of distinct analyst_id and key entries for the review console.
# Generate each key with openssl rand -hex 32 and set this in your local .env.
REVIEW_ANALYST_KEYS=

# Optional JSON array of individual operator_id and key entries for configuration writes.
OPERATOR_API_KEYS=

# Optional shared secret for the signed POST /chargebacks webhook, at least 32 bytes
# and different from API_KEY. Generate it with openssl rand -hex 32. While it is
# empty, the webhook returns 503.
CHARGEBACK_WEBHOOK_SECRET=

# Optional POST /score limits; empty uses 100 requests per second, a burst of 200 and a 2s deadline. SCORE_RATE_LIMIT=0 turns the rate limit off.
SCORE_RATE_LIMIT=
SCORE_RATE_BURST=
SCORE_TIMEOUT=

# Optional DogStatsD address for scoring metrics, for example datadog:8125; empty turns them off.
DOGSTATSD_ADDR=

# Optional size of the backend's database pool; empty uses pgx's default, the larger of 4 and the number of CPUs.
DB_MAX_CONNS=

# Local PostgreSQL credentials
POSTGRES_USER=antifraud
POSTGRES_PASSWORD=antifraud
POSTGRES_DB=antifraud
RUNTIME_DB_PASSWORD=local-runtime-password

# Host port PostgreSQL is published on
POSTGRES_PORT=5432

# Host port Redis is published on
REDIS_PORT=6379

# Redis connection for the blocklist cache.
# Empty disables the cache and queries PostgreSQL directly.
REDIS_URL=redis://localhost:6379/0

# Database connection for a backend running on the host.
# Use the restricted runtime role. Update this URL when changing the port or password.
DATABASE_URL=postgres://antifraud_api:local-runtime-password@localhost:5432/antifraud?sslmode=disable

# Fraud model file, relative to backend/ when running with `make run`.
# Leave empty to score with rules only. Docker Compose sets its own path.
MODEL_PATH=models/lgbm-game-v9.json

# IP intelligence provider for the datacenter_ip and anonymous_ip rules: mock,
# or off (also none or empty) to score without IP lookups. The mock flags
# documentation addresses only (192.0.2.0/24 and parts of 2001:db8::/32).
IP_INTEL_PROVIDER=mock
# Optional JSON file of {"cidr", "kind"} entries that replaces the mock's ranges.
# The backend reads the path: a host path with `make run`, a path inside the
# backend container under Docker Compose, which mounts no such file by default.
IP_INTEL_MOCK_RANGES=

# Enable console-managed simulation runs explicitly.
SIMULATION_ENABLED=false

# Private evaluation connection, required for scored CLI runs and enabled simulations.
# Also enables read-only quality reports while simulation controls are disabled.
LABELS_DB_PASSWORD=local-labels-password
LABELS_DATABASE_URL=postgres://antifraud_labels:local-labels-password@localhost:5432/antifraud?sslmode=disable
