# Port the backend listens on
PORT=8080

# Key that clients send in the X-API-Key header to call POST /score.
# Use a long random value outside local development.
API_KEY=local-dev-key

# Optional JSON array of distinct analyst_id and key entries for the review console.
# Generate each key with openssl rand -hex 32 and set this in your local .env.
REVIEW_ANALYST_KEYS=

# Local PostgreSQL credentials
POSTGRES_USER=antifraud
POSTGRES_PASSWORD=antifraud
POSTGRES_DB=antifraud

# Host port PostgreSQL is published on
POSTGRES_PORT=5432

# Database connection for a backend running on the host.
# Docker Compose builds its own URL from the POSTGRES_* values above.
DATABASE_URL=postgres://antifraud:antifraud@localhost:5432/antifraud?sslmode=disable

# Fraud model file, relative to backend/ when running with `make run`.
# Leave empty to score with rules only. Docker Compose sets its own path.
MODEL_PATH=models/lgbm-ieee-v5-combined.json
