PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

API_KEY=

# 80 requests per second is the safe limit measured on the t3.small (LOAD_TEST.md).
SCORE_RATE_LIMIT=80
SCORE_RATE_BURST=
SCORE_TIMEOUT=

POSTGRES_USER=antifraud
POSTGRES_PASSWORD=
RUNTIME_DB_PASSWORD=
POSTGRES_DB=antifraud

MODEL_FILE=lgbm-game-v9.json

# Redis blocklist cache. Empty disables the cache.
REDIS_URL=redis://redis:6379/0

CONSOLE_HOST=
API_HOST=

# The mock IP intelligence provider flags documentation addresses only, so it
# never flags real traffic. Keep it off until a real provider is integrated.
IP_INTEL_PROVIDER=off

# Enable console-managed simulation runs explicitly.
SIMULATION_ENABLED=false

# Configure when enabling simulations; use a separate generated password.
LABELS_DB_PASSWORD=
